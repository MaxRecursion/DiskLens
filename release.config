# DiskLens release configuration — edit before publishing.
APP_NAME="DiskLens"
# Permanent once used in App Store Connect: register it at developer.apple.com → Identifiers.
BUNDLE_ID="com.akshaykulkarni.DiskLens"
VERSION="1.0.0"
BUILD_NUMBER="1"
COPYRIGHT="© 2026 Akshay Kulkarni"
MIN_MACOS="14.0"
# Public pages (required by App Review). Host docs/site/ (e.g. GitHub Pages) and put the URLs here.
SUPPORT_URL="https://example.com/disklens/support"
PRIVACY_URL="https://example.com/disklens/privacy"
TERMS_URL="https://example.com/disklens/terms"
# Direct edition: checkout page of your merchant of record (Paddle / Lemon Squeezy / FastSpring).
PURCHASE_URL="https://example.com/disklens/buy"
# Direct edition: Sparkle appcast (HTTPS) — see docs/LICENSING.md ▸ Sparkle.
SPARKLE_FEED_URL="https://example.com/disklens/appcast.xml"

# Signing (leave empty to build an ad-hoc signed app for local testing).
TEAM_ID=""
APPSTORE_SIGN_IDENTITY=""        # e.g. "Apple Distribution: Your Name (TEAMID)"
INSTALLER_SIGN_IDENTITY=""       # e.g. "3rd Party Mac Developer Installer: Your Name (TEAMID)"
PROVISIONING_PROFILE=""          # path to the Mac App Store .provisionprofile for BUNDLE_ID
DEVELOPER_ID_IDENTITY=""         # e.g. "Developer ID Application: Your Name (TEAMID)"
NOTARY_PROFILE=""                # keychain profile from: xcrun notarytool store-credentials
